#!/bin/bash
set -eu

RUN_DIR=/var/vcap/sys/run/squid
LOG_DIR=/var/vcap/sys/log/squid
JOB_DIR=/var/vcap/jobs/squid
PIDFILE=$RUN_DIR/squid.pid
mkdir -p $LOG_DIR $RUN_DIR
exec >>$LOG_DIR/squid.log 2>&1

case $1 in
  start)
    if [[ -f $PIDFILE ]]; then
      PID=$(head -1 $PIDFILE)
      test -n "$PID" && test -e /proc/$PID && exit 1
      rm -f $PIDFILE
    fi

    echo "$(date) starting up squid (pid $$)"
    chown -Rv vcap:vcap $LOG_DIR $RUN_DIR

    # Squid runs as vcap from the start, as it always has.  setpriv comes
    # with util-linux on every stemcell, while chpst came with runit, which
    # the resolute stemcell no longer ships.
    setpriv --reuid=vcap --regid=vcap --init-groups \
      /var/vcap/packages/squid/sbin/squid \
        -f $JOB_DIR/config/squid.conf
    ;;

  stop)
    echo "$(date) shutting down squid"
    PID=$(head -1 $PIDFILE)
    if [[ -n "$PID" ]]; then
      kill -TERM $PID || true
      # squid.conf gives clients 10 seconds (shutdown_lifetime) to finish,
      # so a squid still running after 20 seconds is stuck.  Kill its kid
      # with it, or the kid outlives the master and keeps holding the port.
      (sleep 20; [ -e /proc/$PID ] && { pkill -KILL -P $PID; kill -KILL $PID; })&
      WATCHDOG=$!
      while [ -e /proc/$PID ]; do sleep 0.1; done
      # Squid exited on its own, so cancel the watchdog before the pid can
      # be reused by some other process.
      kill $WATCHDOG 2>/dev/null || true
    fi
    rm -f $PIDFILE
    ;;

  *)
    echo "Usage: squid {start|stop}"
    exit 1
    ;;
esac
exit 0
